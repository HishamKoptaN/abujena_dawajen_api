{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "cloudinary-labs/cloudinary-laravel": "^2.1",
        "doctrine/dbal": "^3.8",
        "google/apiclient": "^2.15",
        "google/auth": "^1.45",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^9.0",
        "kreait/firebase-php": "^7.9",
        "kreait/laravel-firebase": "^5.0",
        "laravel/framework": "^9.52.22",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.10",
        "league/flysystem-aws-s3-v3": "3.0",
        "php-ffmpeg/php-ffmpeg": "^1.2",
        "pusher/pusher-php-server": "^7.2",
        "rachidlaasri/laravel-installer": "^4.1",
        "spatie/laravel-permission": "^5.11",
        "symfony/apache-pack": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.4.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "app/Models",
            "app/Http/Controllers",
            "database/seeders"
        ],
        "files": [
            "app/Helpers/api_helpers.php",
            "app/Helpers/pagination_helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD); if [ \"$CURRENT_BRANCH\" = \"main\" ]; then cp .prod.env .env; elif [ \"$CURRENT_BRANCH\" = \"dev\" ]; then cp .dev.env .env; else cp .env.example .env; fi",
            "@php artisan migrate --force",
            "@php artisan config:cache",
            "@php artisan route:cache",
            "@php artisan view:cache"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "@php artisan test",
        "test:coverage": "@php artisan test --coverage"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "memory-limit": "4G",
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": false
}
